{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatherTalk protocol v1",
  "description": "JSON Lines worker transport and desktop task projection. Sequence is monotonically increasing within each worker process or local resource task. Ready and RequestRejected have no task ID; every task event requires a UUID. Non-finite metrics are forbidden on the wire.",
  "oneOf": [
    { "$ref": "#/$defs/WorkerPrelude" },
    {
      "$ref": "#/$defs/WorkerRequest"
    },
    {
      "$ref": "#/$defs/WorkerEvent"
    }
  ],
  "$defs": {
    "TargetPlatform": {
      "type": "object",
      "properties": {
        "os": { "enum": ["windows", "linux", "macos"] },
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "backend": { "enum": ["cpu", "cuda", "vulkan", "metal", "any"] }
      },
      "required": ["os", "architecture", "backend"],
      "additionalProperties": false
    },
    "ProjectBinding": {
      "type": "object",
      "properties": {
        "project_id": { "$ref": "#/$defs/ProjectId" },
        "directory": { "type": "string" }
      },
      "required": ["project_id", "directory"],
      "additionalProperties": false
    },
    "RuntimeComponent": {
      "type": "object",
      "properties": {
        "target": { "anyOf": [{ "$ref": "#/$defs/TargetPlatform" }, { "type": "null" }] },
        "pin": { "$ref": "#/$defs/ResourcePin" },
        "root": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "path": { "type": "string" }, "sha256": { "type": "string" } },
            "required": ["path", "sha256"],
            "additionalProperties": false
          }
        }
      },
      "required": ["target", "pin", "root", "files"],
      "additionalProperties": false
    },
    "WorkerPrelude": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol_version": { "const": 1 },
            "context": { "$ref": "#/$defs/WorkerContext" }
          },
          "required": ["protocol_version", "context"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Projectless Hello and Shutdown only. Start is rejected.",
          "properties": {
            "protocol_version": { "const": 1 },
            "target": { "$ref": "#/$defs/TargetPlatform" },
            "components": { "type": "array", "items": { "$ref": "#/$defs/RuntimeComponent" } },
            "cuda_root": { "type": ["string", "null"] }
          },
          "required": ["protocol_version", "target", "components", "cuda_root"],
          "additionalProperties": false
        }
      ]
    },
    "WorkerContext": {
      "type": "object",
      "properties": {
        "protocol_version": { "const": 1 },
        "projects": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/ProjectBinding" } },
        "target": { "$ref": "#/$defs/TargetPlatform" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/RuntimeComponent" } },
        "assets": { "type": "string" },
        "ffmpeg": { "type": "string" },
        "ffprobe": { "type": "string" },
        "probe_runner": { "type": "string" },
        "cuda_root": { "type": ["string", "null"] }
      },
      "required": ["protocol_version", "projects", "target", "components", "assets", "ffmpeg", "ffprobe", "probe_runner", "cuda_root"],
      "additionalProperties": false
    },
    "TaskId": {
      "type": "string",
      "format": "uuid"
    },
    "ProjectId": {
      "type": "string",
      "format": "uuid"
    },
    "TrainingRunId": {
      "type": "string",
      "format": "uuid"
    },
    "BackendKind": {
      "type": "string",
      "enum": [
        "flex",
        "cpu",
        "vulkan",
        "cuda",
        "metal"
      ]
    },
    "Precision": {
      "type": "string",
      "enum": [
        "f32",
        "f16",
        "bf16"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_config",
        "model_mismatch",
        "resource_missing",
        "resource_corrupt",
        "unsupported_backend",
        "device_init",
        "device_lost",
        "out_of_memory",
        "no_face",
        "no_audio",
        "encode_failed",
        "disk_full",
        "permission_denied",
        "busy",
        "protocol",
        "cancelled",
        "internal"
      ]
    },
    "AppError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "stage": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "stage",
        "message",
        "evidence",
        "actions",
        "log_path"
      ],
      "additionalProperties": false
    },
    "LossConfig": {
      "type": "object",
      "properties": {
        "full": {
          "type": "number",
          "minimum": 0
        },
        "mouth": {
          "type": "number",
          "minimum": 0
        },
        "temporal": {
          "type": "number",
          "minimum": 0
        },
        "temporal_mouth": {
          "type": "number",
          "minimum": 0
        },
        "perceptual": {
          "type": "number",
          "minimum": 0
        },
        "mouth_gradient": {
          "type": "number",
          "minimum": 0
        },
        "temporal_kernel": {
          "type": "integer",
          "minimum": 1,
          "not": {
            "multipleOf": 2
          }
        },
        "temporal_stride": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "full",
        "mouth",
        "temporal",
        "temporal_mouth",
        "perceptual",
        "mouth_gradient",
        "temporal_kernel",
        "temporal_stride"
      ],
      "additionalProperties": false
    },
    "TrainConfig": {
      "type": "object",
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "default": 42 },
        "prefetch_capacity": { "type": "integer", "minimum": 0, "maximum": 32, "default": 2 },
        "epochs": {
          "type": "integer",
          "minimum": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "lr": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "beta1": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "beta2": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "epsilon": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weight_decay": {
          "type": "number",
          "minimum": 0
        },
        "save_every": {
          "type": "integer",
          "minimum": 1
        },
        "loss": {
          "$ref": "#/$defs/LossConfig"
        }
      },
      "required": [
        "epochs",
        "batch_size",
        "lr",
        "beta1",
        "beta2",
        "epsilon",
        "weight_decay",
        "save_every",
        "loss"
      ],
      "additionalProperties": false
    },
    "DeviceRequest": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/BackendKind"
        },
        "device_id": {
          "type": "string"
        }
      },
      "required": [
        "backend",
        "device_id"
      ],
      "additionalProperties": false
    },
    "DevicePolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "policy": {
              "const": "auto"
            }
          },
          "required": [
            "policy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "const": "explicit"
            },
            "request": {
              "$ref": "#/$defs/DeviceRequest"
            }
          },
          "required": [
            "policy",
            "request"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DeviceDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "driver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "backend": {
          "$ref": "#/$defs/BackendKind"
        },
        "memory_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "vendor",
        "driver",
        "backend",
        "memory_bytes"
      ],
      "additionalProperties": false
    },
    "ModelIdentity": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "architecture_version": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        },
        "weights_sha256": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "architecture_version",
        "source_sha256",
        "weights_sha256"
      ],
      "additionalProperties": false
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "run_id": {
          "$ref": "#/$defs/TrainingRunId"
        },
        "checkpoint_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "checkpoint_id"
      ],
      "additionalProperties": false
    },
    "TrainRequest": {
      "type": "object",
      "properties": {
        "batch_mode": { "enum": ["auto", "fixed"], "default": "auto" },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "config": {
          "$ref": "#/$defs/TrainConfig"
        },
        "device": {
          "$ref": "#/$defs/DevicePolicy"
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_id",
        "config",
        "device",
        "resume"
      ],
      "additionalProperties": false
    },
    "GenerateRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "audio_path": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "model_ref": {
          "$ref": "#/$defs/ModelRef"
        },
        "device": {
          "$ref": "#/$defs/DevicePolicy"
        }
      },
      "required": [
        "project_id",
        "audio_path",
        "output_path",
        "model_ref",
        "device"
      ],
      "additionalProperties": false
    },
    "JobSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "train"
            },
            "request": {
              "$ref": "#/$defs/TrainRequest"
            }
          },
          "required": [
            "kind",
            "request"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "generate"
            },
            "request": {
              "$ref": "#/$defs/GenerateRequest"
            }
          },
          "required": [
            "kind",
            "request"
          ],
          "additionalProperties": false
        }
      ]
    },
    "JobKind": {
      "type": "string",
      "enum": [
        "train",
        "generate",
        "prepare_resources"
      ]
    },
    "WorkerRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "hello"
            },
            "protocol_version": {
              "const": 1
            }
          },
          "required": [
            "type",
            "protocol_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "start"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            },
            "job": {
              "$ref": "#/$defs/JobSpec"
            }
          },
          "required": [
            "type",
            "task_id",
            "job"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "cancel"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            }
          },
          "required": [
            "type",
            "task_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "shutdown"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ComponentCapability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "version",
        "available"
      ],
      "additionalProperties": false
    },
    "WorkerCapabilities": {
      "type": "object",
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentCapability"
          }
        },
        "training": {
          "type": "boolean"
        },
        "generation": {
          "type": "boolean"
        }
      },
      "required": [
        "engine_version",
        "components",
        "training",
        "generation"
      ],
      "additionalProperties": false
    },
    "LossScalars": {
      "type": "object",
      "properties": {
        "full": {
          "type": "number"
        },
        "mouth": {
          "type": "number"
        },
        "temporal": {
          "type": "number"
        },
        "temporal_mouth": {
          "type": "number"
        },
        "perceptual": {
          "type": "number"
        },
        "mouth_gradient": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      },
      "required": [
        "full",
        "mouth",
        "temporal",
        "temporal_mouth",
        "perceptual",
        "mouth_gradient",
        "total"
      ],
      "additionalProperties": false
    },
    "TrainingMetrics": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "run_id": {
          "$ref": "#/$defs/TrainingRunId"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "lr": {
          "type": "number"
        },
        "losses": {
          "$ref": "#/$defs/LossScalars"
        },
        "device": {
          "$ref": "#/$defs/DeviceDescriptor"
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "project_id",
        "run_id",
        "step",
        "epoch",
        "elapsed_ms",
        "lr",
        "losses",
        "device",
        "precision",
        "batch_size"
      ],
      "additionalProperties": false
    },
    "ExportResult": {
      "type": "object",
      "properties": {
        "output_path": {
          "type": "string"
        },
        "video_frames": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "device": {
          "$ref": "#/$defs/DeviceDescriptor"
        }
      },
      "required": [
        "output_path",
        "video_frames",
        "elapsed_ms",
        "device"
      ],
      "additionalProperties": false
    },
    "ArtifactResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "model"
            },
            "artifact": {
              "$ref": "#/$defs/ModelRef"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "video"
            },
            "artifact": {
              "$ref": "#/$defs/ExportResult"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "resources" },
            "artifact": { "$ref": "#/$defs/ResourceInventory" }
          },
          "required": ["kind", "artifact"],
          "additionalProperties": false
        }
      ]
    },
    "ResourcePin": {
      "type": "object",
      "properties": { "id": { "type": "string" }, "version": { "type": "string" } },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "ResourceInventory": {
      "type": "object",
      "properties": {
        "ready": { "type": "boolean" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ResourceStatus" } }
      },
      "required": ["ready", "items"],
      "additionalProperties": false
    },
    "ResourceStatus": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "#/$defs/ResourcePin" },
        "identity": { "anyOf": [{ "$ref": "#/$defs/ModelIdentity" }, { "type": "null" }] },
        "path": { "type": ["string", "null"] },
        "ready": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      },
      "required": ["resource", "identity", "path", "ready", "reason"],
      "additionalProperties": false
    },
    "EventPayload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "request_rejected" },
            "request": { "enum": ["hello", "start", "cancel", "shutdown"] },
            "requested_task_id": { "anyOf": [{ "$ref": "#/$defs/TaskId" }, { "type": "null" }] },
            "error": { "$ref": "#/$defs/AppError" }
          },
          "required": ["type", "request", "requested_task_id", "error"],
          "additionalProperties": false,
          "if": { "properties": { "request": { "enum": ["start", "cancel"] } } },
          "then": { "properties": { "requested_task_id": { "$ref": "#/$defs/TaskId" } } },
          "else": { "properties": { "requested_task_id": { "type": "null" } } }
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ready"
            },
            "capabilities": {
              "$ref": "#/$defs/WorkerCapabilities"
            },
            "devices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DeviceDescriptor"
              }
            }
          },
          "required": [
            "type",
            "capabilities",
            "devices"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "started"
            },
            "job": {
              "$ref": "#/$defs/JobKind"
            }
          },
          "required": [
            "type",
            "job"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "progress"
            },
            "stage": {
              "type": "string"
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "stage",
            "completed",
            "total"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "metrics"
            },
            "project_id": {
              "$ref": "#/$defs/ProjectId"
            },
            "run_id": {
              "$ref": "#/$defs/TrainingRunId"
            },
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "elapsed_ms": {
              "type": "integer",
              "minimum": 0
            },
            "lr": {
              "type": "number"
            },
            "losses": {
              "$ref": "#/$defs/LossScalars"
            },
            "device": {
              "$ref": "#/$defs/DeviceDescriptor"
            },
            "precision": {
              "$ref": "#/$defs/Precision"
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "project_id",
            "run_id",
            "step",
            "epoch",
            "elapsed_ms",
            "lr",
            "losses",
            "device",
            "precision",
            "batch_size"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "checkpoint_committed"
            },
            "model_ref": {
              "$ref": "#/$defs/ModelRef"
            }
          },
          "required": [
            "type",
            "model_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "completed"
            },
            "result": {
              "$ref": "#/$defs/ArtifactResult"
            }
          },
          "required": [
            "type",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "cancelled"
            },
            "checkpoint": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModelRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "checkpoint"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "failed"
            },
            "error": {
              "$ref": "#/$defs/AppError"
            }
