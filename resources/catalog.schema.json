{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "components",
    "defaults"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "defaults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "architecture_version",
        "source_sha256",
        "weights_sha256"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "architecture_version": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "weights_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "relative_files",
        "sizes",
        "hashes",
        "urls",
        "min_engine_version",
        "provenance"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "relative_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sizes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "urls": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "min_engine_version": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "backend"
      ],
      "properties": {
        "os": {
          "enum": [
            "windows",
            "linux",
            "macos"
          ]
        },
        "architecture": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "backend": {
          "enum": [
            "cpu",
            "cuda",
            "vulkan",
            "metal",
            "any"
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "resources"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "sha256",
        "urls"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin",
        "target",
        "kind",
        "manifest",
        "manifest_sha256",
        "manifest_size",
        "manifest_urls",
        "supplemental",
        "executables",
        "notices",
        "redistribution_approved",
        "license"
      ],
      "properties": {
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_size": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supplemental": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/file"
          }
        },
        "executables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redistribution_approved": {
          "type": "boolean"
        },
        "license": {
          "type": "string"
        }
      }
    }
  }
}
